# ---------------------------------------------------------------------------
# imagegen-playground — environment variables
#
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# Vercel: add each key in Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# ── Firecrawl (Step 1: scrape_client_site) ──────────────────────────────────
FIRECRAWL_API_KEY=

# ── Portkey AI LLM gateway (Steps 2–4: Claude calls) ───────────────────────
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=pc-portke-0dd3de

# ── Replicate (Step 5: generate_image — google/nano-banana-pro etc.) ───────
REPLICATE_API_TOKEN=

# ── fal.ai (Blog v2 / custom:cover_thumbnail when gpt-image-2 is selected) ──
# Only consumed by src/lib/providers/fal.ts. route.ts routes the
# (pipelineKey="custom:cover_thumbnail", model="openai/gpt-image-2") combo
# to fal.ai's openai/gpt-image-2/edit endpoint; every other (pipeline, model)
# combo continues to use Replicate.
FAL_KEY=
